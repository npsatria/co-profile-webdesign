---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="28 UI Project / Atrem Project"
    description="Detail dari 28 UI Design Projects selama PKL."
>
    <!-- Navigation Navbar -->
    <nav class="fixed z-40 my-container navbar w-full">
        <div class="navbar-start"></div>
        <div class="border navbar-center backdrop-blur-lg rounded-3xl w-fit bg-base-100/50 border-primary/5 mx-auto">
            <div class="flex p-4 space-x-4">
                <div class="mx-8 space-x-4">
                    <a href="/" class="nav-link">Home</a>
                    <a href="/proto/" class="nav-link">UI Prototype</a>
                    <a href="/28ui/" class="opacity-100 nav-link">UI Project</a>
                    <a href="/mira/" class="nav-link">Mira Course</a>
                    <a href="/package/" class="nav-link">Package</a>
                </div>
            </div>
        </div>
        <div class="navbar-end"></div>
    </nav>

    <!-- Content -->
    <div class="py-[200px] my-container">
        <img src="/assets/images/uifix.png" alt="" class="mx-auto" />
        <div class="mt-12 px-28">
            <div class="flex justify-between">
                <div>
                    <p class="text-3xl font-bold text-text">28 UI Design Projects</p>
                    <div class="flex space-x-3 mt-4">
                        <div class="duration-200 my-badge">UX Research</div>
                        <div class="duration-200 my-badge">UX Testing</div>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
